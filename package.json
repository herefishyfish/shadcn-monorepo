{
  "name": "shadcn-monorepo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @repo/web",
    "android": "npm run android -w @repo/nativescript",
    "ios": "npm run ios -w @repo/nativescript",
    "windows": "npm run windows -w @repo/nativescript",
    "clean": "npm run clean -w @repo/nativescript",
    "typecheck": "turbo typecheck"
  },
  "devDependencies": {
    "turbo": "^2.5.6"
  },
  "overrides": {
    "@nativescript/core": "https://pkg.pr.new/@nativescript/core@fa5d852",
    "@nativescript/canvas": "3.0.0-beta.4",
    "@nativescript/canvas-svg": "3.0.0-beta.4"
  }
}
